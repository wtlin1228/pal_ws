<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_perception</name>
  <version>0.1.0</version>
  <description>Height-map box detector: PointCloud2 to Detection3DArray, OpenCV (Ch 10).</description>
  <maintainer email="tutorial@example.invalid">tutorial</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>cell_planning</depend>
  <depend>cell_interfaces</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
