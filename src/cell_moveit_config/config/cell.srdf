<?xml version="1.0" encoding="UTF-8"?>
<!-- Semantic description of the cell: planning groups, named poses, end effector, disabled collision pairs. -->
<robot name="cell">
    <group name="arm">
        <chain base_link="base_link" tip_link="tcp"/>
    </group>
    <group name="gripper">
        <link name="gripper_body"/>
        <link name="suction_pad"/>
        <link name="tcp"/>
    </group>
    <group_state name="home" group="arm">
        <joint name="shoulder_pan_joint" value="0"/>
        <joint name="shoulder_lift_joint" value="-1.57"/>
        <joint name="elbow_joint" value="1.57"/>
        <joint name="wrist_1_joint" value="-1.57"/>
        <joint name="wrist_2_joint" value="-1.57"/>
        <joint name="wrist_3_joint" value="0"/>
    </group_state>
    <end_effector name="suction" parent_link="tcp" group="gripper" parent_group="arm"/>

    <!-- UR10e pairs, as in ur_moveit_config -->
    <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
    <disable_collisions link1="base_link_inertia" link2="upper_arm_link" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
    <disable_collisions link1="shoulder_link" link2="wrist_1_link" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="wrist_2_link" reason="Never"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
    <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
    <!-- gripper: rigidly attached to wrist_3 through flange and tool0 -->
    <disable_collisions link1="wrist_3_link" link2="gripper_body" reason="Adjacent"/>
    <disable_collisions link1="gripper_body" link2="suction_pad" reason="Adjacent"/>
    <disable_collisions link1="wrist_3_link" link2="suction_pad" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="gripper_body" reason="Never"/>
    <disable_collisions link1="wrist_2_link" link2="suction_pad" reason="Never"/>
    <!-- static cell parts: never move relative to each other or to the base -->
    <disable_collisions link1="pedestal" link2="base_link_inertia" reason="Default"/>
    <disable_collisions link1="pedestal" link2="shoulder_link" reason="Never"/>
    <disable_collisions link1="pedestal" link2="pallet" reason="Never"/>
    <disable_collisions link1="pedestal" link2="conveyor" reason="Never"/>
    <disable_collisions link1="pallet" link2="conveyor" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="pallet" reason="Never"/>
    <disable_collisions link1="base_link_inertia" link2="conveyor" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="pallet" reason="Never"/>
    <disable_collisions link1="shoulder_link" link2="conveyor" reason="Never"/>
</robot>
